{
  "name": "phpcronmgr/jira2redmine_migration",
  "description": "Jira to Redmine migration script",
  "type": "project",
  "autoload": {
    "psr-4": {
      "Jira2Redmine\\": "src/",
      "Karvaka\\AdfToGfm\\": "Karvaka/AdfToGfm/src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.10",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-ctype": "*",
    "ext-json": "*",
    "league/html-to-markdown": "^5.1",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-openssl": "*"
  },
  "license": "GPL-3.0",
  "authors": [
    {
      "name": "Jan Catrysse"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  }
