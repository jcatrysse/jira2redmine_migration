# Static analysis of src/, the tests and the shared lib files; the 16 scripts are analysed one by one (phpstan-scripts.neon).
parameters:
    level: 8
    paths:
        - src
        - lib/cli.php
        - lib/jira_gateway.php
        - lib/verify.php
        - lib/requirements.php
        - tests
    bootstrapFiles:
        - vendor/autoload.php
        - lib/jira_gateway.php
        - lib/verify.php
        - lib/description_conversion.php
