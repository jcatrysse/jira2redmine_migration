# Errors of 10_migrate_issues.php PHPStan may report (tools/qa.sh): only what cannot be fixed without a change of
# behaviour, each with its reason. Phase 6 (plan M1) keeps the behaviour; a fix is a decision for Jan.
parameters:
    ignoreErrors:
        -
            # buildRedmineAttachmentFilename(): preg_replace() returns null on a PCRE error and the next call takes it,
            # a TypeError under strict_types that stops 10. Handling it (keep the name as it was) changes what 10 does.
            message: '#^Parameter \#3 \$subject of function preg_replace expects array\<float\|int\|string\>\|string, string\|null given\.$#'
            identifier: argument.type
            count: 1
            path: ../../10_migrate_issues.php
        -
            # The same chain: ltrim() of its result.
            message: '#^Parameter \#1 \$string of function ltrim expects string, string\|null given\.$#'
            identifier: argument.type
            count: 1
            path: ../../10_migrate_issues.php
        -
            # normalizeLabelKey(): preg_replace() with /u returns null for text that is not valid UTF-8, and trim()
            # then throws a TypeError, as before. Jira sends UTF-8.
            message: '#^Parameter \#1 \$string of function trim expects string, string\|null given\.$#'
            identifier: argument.type
            count: 1
            path: ../../10_migrate_issues.php
