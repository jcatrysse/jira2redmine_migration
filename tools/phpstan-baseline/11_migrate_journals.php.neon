# Errors of 11_migrate_journals.php PHPStan may report (tools/qa.sh): only what cannot be fixed without a change of
# behaviour, each with its reason. Phase 6 (plan M1) keeps the behaviour; a fix is a decision for Jan.
parameters:
    ignoreErrors:
        -
            # normalizeJournalAttachmentLinks(): preg_replace_callback() returns null on a PCRE error (a backtrack
            # limit), and the next call takes that null; under strict_types that is a TypeError, which stops 11.
            # Handling the error (keep the text as it was, or skip the link rewrite) changes what 11 does then.
            message: '#^Parameter \#3 \$subject of function preg_replace_callback expects array\<float\|int\|string\>\|string, string\|null given\.$#'
            identifier: argument.type
            count: 5
            path: ../../11_migrate_journals.php
        -
            # The same chain: its last result goes to normalizeRedmineReferenceSpacing(), a TypeError on null.
            message: '#^Parameter \#1 \$text of function normalizeRedmineReferenceSpacing expects string, string\|null given\.$#'
            identifier: argument.type
            count: 1
            path: ../../11_migrate_journals.php
        -
            # buildJournalAttachmentBlock(): preg_replace() with /u returns null for a file name that is not valid
            # UTF-8; trim() then throws a TypeError, as before. Jira sends UTF-8 names.
            message: '#^Parameter \#1 \$string of function trim expects string, string\|null given\.$#'
            identifier: argument.type
            count: 1
            path: ../../11_migrate_journals.php
